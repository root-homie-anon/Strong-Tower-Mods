ANTHROPIC_API_KEY=
# Set to "true" in dev/test only — bypasses Anthropic API and returns a hardcoded mock.
# MUST be unset in production.
ANTHROPIC_MOCK=

# ElevenLabs voice synthesis (Phase A)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional override; defaults to eleven_turbo_v2_5.
ELEVENLABS_MODEL_ID=
# Set to "true" in dev/test only — returns 1.0 s of silent WAV instead of calling ElevenLabs.
# MUST be unset in production.
ELEVENLABS_MOCK=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXUS_API_KEY=
# Dev default uses SQLite under packages/shared/db/prisma/dev.db.
# Swap to a Postgres URL for prod: postgresql://user:pass@host:5432/strong_tower
DATABASE_URL=file:./dev.db
JWT_SECRET=

# Cloud companion API
CLOUD_PORT=8080
CLOUD_WS_URL=ws://localhost:8080/ws/companion

# Sidecar
SIDECAR_PORT=4999
# Optional override for synthesised audio output dir.
# Defaults to ~/.local/share/strong-tower-mods/audio
AUDIO_OUTPUT_DIR=

# MemPalace memory (Phase D)
# Per-user palace root; one subdir per sessionId. Defaults to
# ~/.local/share/strong-tower-mods/memory
MEMORY_DIR=
# Set to "true" in dev/test only — recall returns empty, store_turn is a no-op.
# MUST be unset in production.
MEMORY_MOCK=

# ----------------------------------------------------------------------
# Non-redistributable binaries (drop into tools/, set absolute path here)
# See tools/README.md for download sources and licensing notes.
# ----------------------------------------------------------------------

# FaceFXWrapper.exe — Nukem9's wrapper, used by Phase B for LIP file
# generation. Distributed with LipFuzer on Nexus.
FACEFX_WRAPPER_PATH=

# xWMAEncode.exe — WAV → XWM conversion for FUZ packing.
# Originally shipped in the DirectX SDK June 2010 (bin/x64/).
XWMAENCODE_PATH=

# FO4Edit.exe (xEdit) — ESP record-level inspection in Phase 3.
XEDIT_PATH=

# F4SE SDK root directory (clone of ianpatt/f4se). Phase C C++ plugin
# build expects to find <F4SE_SDK_PATH>/src/f4se/ for headers/libs.
F4SE_SDK_PATH=

# Cloud companion API base URL — the Vortex extension reads this from
# its own settings store, not this file. Listed here only so contributors
# spinning up the cloud locally know which port the extension default
# connects to.
# CLOUD_API_BASE_URL=http://127.0.0.1:8080
