ANTHROPIC_API_KEY=
# Set to "true" in dev/test only — bypasses Anthropic API and returns a hardcoded mock.
# MUST be unset in production.
ANTHROPIC_MOCK=

# ElevenLabs voice synthesis (Phase A)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional override; defaults to eleven_turbo_v2_5.
ELEVENLABS_MODEL_ID=
# Set to "true" in dev/test only — returns 1.0 s of silent WAV instead of calling ElevenLabs.
# MUST be unset in production.
ELEVENLABS_MOCK=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price ids (PRODUCTION).
# subscriptions.ts builds the env-var name dynamically from the tier
# name (`STRIPE_PRICE_${tier.toUpperCase()}`), so every tier in
# packages/shared/billing/src/tiers.ts MUST have a matching key here
# once you flip out of STRIPE_MOCK=true. Get the price ids from the
# Stripe dashboard after creating each product.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_CUSTOM=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_BUNDLE_BASIC_CREATOR=
STRIPE_PRICE_BUNDLE_PREMIUM_CREATOR=
STRIPE_PRICE_BUNDLE_CUSTOM_CREATOR=

NEXUS_API_KEY=
# Dev default uses SQLite under packages/shared/db/prisma/dev.db.
# Swap to a Postgres URL for prod: postgresql://user:pass@host:5432/strong_tower
DATABASE_URL=file:./dev.db
JWT_SECRET=

# Cloud companion API
CLOUD_PORT=8080
# WebSocket URL the sidecar dials. Must match the cloud's registered
# /companion/turn route (see packages/shared/api/companion/src/turn.ts).
CLOUD_WS_URL=ws://127.0.0.1:8080/companion/turn
# Per-WS-connection hard cap on turn.request frames. Defaults to 200
# when unset; lower in tests, raise in production behind a rate limit.
MAX_TURNS_PER_CONNECTION=200

# Sidecar
SIDECAR_PORT=4999
# Optional override for synthesised audio output dir.
# Defaults to ~/.local/share/strong-tower-mods/audio
AUDIO_OUTPUT_DIR=
# Bearer token the sidecar sends on its WS to the cloud. Defaults to
# the literal 'dev-token' which AUTH_MOCK=true accepts. Production
# sidecars must mint a real JWT via /session/open and set this to the
# returned token.
CLOUD_DEV_TOKEN=dev-token

# MemPalace memory (Phase D)
# Per-user palace root; one subdir per sessionId. Defaults to
# ~/.local/share/strong-tower-mods/memory
MEMORY_DIR=
# Set to "true" in dev/test only — recall returns empty, store_turn is a no-op.
# MUST be unset in production.
MEMORY_MOCK=

# ----------------------------------------------------------------------
# Non-redistributable binaries (drop into tools/, set absolute path here)
# See tools/README.md for download sources and licensing notes.
# ----------------------------------------------------------------------

# FaceFXWrapper.exe — Nukem9's wrapper, used by Phase B for LIP file
# generation. Distributed with LipFuzer on Nexus.
FACEFX_WRAPPER_PATH=

# xWMAEncode.exe — WAV → XWM conversion for FUZ packing.
# Originally shipped in the DirectX SDK June 2010 (bin/x64/).
XWMAENCODE_PATH=

# FO4Edit.exe (xEdit) — ESP record-level inspection in Phase 3.
XEDIT_PATH=

# F4SE SDK root directory (clone of ianpatt/f4se). Phase C C++ plugin
# build expects to find <F4SE_SDK_PATH>/src/f4se/ for headers/libs.
F4SE_SDK_PATH=

# Cloud companion API base URL — the Vortex extension reads this from
# its own settings store, not this file. Listed here only so contributors
# spinning up the cloud locally know which port the extension default
# connects to.
# CLOUD_API_BASE_URL=http://127.0.0.1:8080

# ----------------------------------------------------------------------
# Mock flags (DEVELOPMENT ONLY)
#
# Each flag short-circuits a single external dependency so tests and
# offline dev sessions never need a real API key. Every flag with a
# production-side credential MUST be unset in production; the ones
# below that gate live secrets crash the cloud at boot when combined
# with NODE_ENV=production (see validateAnthropicConfig +
# validateAuthConfig in packages/shared/api/companion/src/).
# ----------------------------------------------------------------------

# AUTH_MOCK=true makes the cloud accept ANY non-empty bearer on the
# turn / load-order / conflict endpoints. The audio-pipeline test
# fixtures rely on this. Production-guarded.
AUTH_MOCK=

# STRIPE_MOCK=true makes shared/billing return deterministic mock_-
# prefixed IDs without hitting the Stripe API. Production-guarded.
STRIPE_MOCK=

# NEXUS_MOCK=true makes the extension's Nexus client return fixture
# data instead of calling the Nexus API. Used by Vortex extension tests.
NEXUS_MOCK=

# NEXUS_SSO_MOCK=true makes the auth package's Nexus SSO flow return
# a deterministic mock profile derived from the SSO flow UUID. Used
# until our Nexus SSO registration is approved.
NEXUS_SSO_MOCK=

# RANKER_MOCK=true makes the extension's load-order ranker apply a
# deterministic local heuristic instead of POSTing to the cloud
# /load-order/rank endpoint. Used in CI and for offline dev.
RANKER_MOCK=

# EXPLAINER_MOCK is the default; set to "false" to take the real
# cloud /conflict/explain path. Used for parity with RANKER_MOCK.
EXPLAINER_MOCK=
